// Phase 1 proved Prisma <-> Postgres <-> pgvector wiring with a minimal
// placeholder model. Phase 2 adds the real authentication + GitHub
// integration models. Everything else (RepositorySnapshot, CodeChunk,
// Finding, ...) still waits for the phases that actually need it — see
// docs/architecture.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

/// Minimal row used by the API's /health check to prove read/write
/// connectivity through Prisma, not just that a TCP connection succeeds.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())

  @@map("health_check")
}

/// A local application user. Identity is entirely GitHub-derived in this
/// phase (no email/password) — see GitHubAccount.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  githubAccount GitHubAccount?
  sessions      Session[]
  repositories  Repository[]

  @@map("user")
}

/// The GitHub identity linked to a User, plus the encrypted access token
/// needed to call the GitHub API on their behalf. One-to-one with User
/// (`userId` unique) — a GitHub account can't be linked to more than one
/// local user, and vice versa.
model GitHubAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// GitHub's numeric user id — stable even if the user renames their
  /// GitHub account, unlike `username`.
  githubId  Int     @unique
  username  String
  avatarUrl String?

  /// AES-256-GCM ciphertext (iv + tag + ciphertext, base64), never the raw
  /// token. See apps/api/src/services/crypto.ts and docs/authentication.md.
  accessTokenEncrypted String

  /// Space-delimited OAuth scopes GitHub actually granted, as reported by
  /// the token exchange response — for display/debugging, not enforcement.
  scope String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("github_account")
}

/// A server-side session. The browser only ever holds an opaque random
/// token in an HttpOnly cookie; this table stores a hash of that token
/// (never the token itself) so a database read alone can't be used to
/// impersonate a session.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("session")
}

/// Metadata for a GitHub repository a user has access to. Deliberately just
/// enough to identify and display it — no content, no clone, no analysis
/// data (that starts in Phase 3+). Scoped per-user rather than globally
/// unique on `githubId`: two different local users can each have their own
/// row for the same underlying GitHub repo (e.g. two collaborators on the
/// same org repo), each reflecting only what that user is authorized to see.
model Repository {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  githubId      Int
  owner         String
  name          String
  fullName      String
  defaultBranch String
  private       Boolean
  htmlUrl       String
  description   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingestions     Ingestion[]
  // Phase 5 — denormalized onto Repository (as well as living under
  // AnalysisRun/RepositoryFile) purely so every embedding/search query that
  // scopes by repository doesn't need to join through Ingestion first. See
  // docs/semantic-search.md.
  embeddingRuns  EmbeddingRun[]
  codeChunks     CodeChunk[]
  // Phase 6 — same denormalization reasoning as embeddingRuns above. See
  // docs/ai-analysis.md.
  aiAnalysisRuns AIAnalysisRun[]

  @@unique([userId, githubId])
  @@index([userId])
  @@map("repository")
}

/// Explicit ingestion state machine (see docs/repository-ingestion.md).
/// Transitions are owned entirely by apps/worker — never client-settable.
/// `RETRIEVING`, not the more git-flavored `CLONING`: this pipeline never
/// runs `git clone` (a real clone can execute hooks); it downloads a GitHub
/// tarball archive instead, and a `CLONING` label would misleadingly imply
/// otherwise.
enum IngestionStatus {
  PENDING
  QUEUED
  RETRIEVING
  EXTRACTING
  SCANNING
  COMPLETED
  FAILED
  CANCELLED
}

/// One attempt at turning a repository (at a specific commit) into scanned,
/// persisted file metadata. Repository contents are never stored in
/// Postgres — only this run's status/counters and, via RepositoryFile,
/// per-file metadata. `@@unique([repositoryId, commitSha])` is the
/// idempotency boundary: re-requesting ingestion at a commit that's already
/// COMPLETED reuses that row instead of redoing the work.
model Ingestion {
  id           String     @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  status    IngestionStatus @default(PENDING)
  commitSha String

  /// Coarse, milestone-based progress (0–100) — see PROGRESS_MILESTONES in
  /// apps/worker/src/ingestion/pipeline.ts. Never implied to be precise.
  progress Int     @default(0)
  error    String?

  fileCount       Int?
  sourceFileCount Int?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  files       RepositoryFile[]
  /// Phase 4 — at most one, see AnalysisRun's `@@unique([ingestionId])`.
  analysisRun AnalysisRun?

  @@unique([repositoryId, commitSha])
  @@index([repositoryId])
  @@map("ingestion")
}

/// How a discovered file was classified. Whole-directory ignores
/// (node_modules, .git, dist, ...) are pruned during the directory walk and
/// never become a row at all — IGNORED here covers individual files
/// excluded for other reasons (oversized, binary where unexpected, etc.)
/// found in directories that were otherwise walked.
enum FileCategory {
  SOURCE
  CONFIG
  DOCUMENTATION
  DATA
  BINARY
  GENERATED
  IGNORED
}

/// Metadata only — never file contents. See packages/code-analysis for the
/// classification rules that produce these rows.
model RepositoryFile {
  id          String    @id @default(cuid())
  ingestionId String
  ingestion   Ingestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)

  path      String
  name      String
  extension String?
  language  String?
  category  FileCategory
  size      Int
  isSource  Boolean
  isIgnored Boolean      @default(false)

  createdAt DateTime @default(now())

  // Phase 4 — populated only for SOURCE files that were actually parsed
  // during an analysis run. See docs/code-intelligence.md.
  symbols            CodeSymbol[]
  imports            CodeImport[]
  resolvedByImports  CodeImport[]     @relation("ResolvedImport")
  dependencyEdgesOut DependencyEdge[] @relation("DependencyEdgeSource")
  dependencyEdgesIn  DependencyEdge[] @relation("DependencyEdgeTarget")
  metrics            CodeMetric[]
  findings           Finding[]
  // Phase 5
  chunks             CodeChunk[]

  @@unique([ingestionId, path])
  @@index([ingestionId])
  @@map("repository_file")
}

// ---------------------------------------------------------------------------
// Phase 4 — Code Intelligence & Static Analysis
//
// Turns an already-ingested repository's file metadata into real code
// intelligence: parsed symbols, imports, a resolved dependency graph,
// deterministic metrics, and deterministic (never AI-generated) findings.
// See packages/code-analysis/src/analysis and docs/code-intelligence.md.
// ---------------------------------------------------------------------------

/// Explicit analysis state machine, named to match Ingestion's convention.
/// Transitions are owned entirely by apps/worker — never client-settable.
enum AnalysisStatus {
  PENDING
  QUEUED
  PARSING
  INDEXING
  ANALYZING
  COMPLETED
  FAILED
  CANCELLED
}

/// One attempt at turning an ingestion's file metadata into code
/// intelligence. One-to-one with its Ingestion (`@@unique([ingestionId])`)
/// — an ingestion is already pinned to a single commit, so re-requesting
/// analysis for the same ingestion reuses (and retries) this same row,
/// mirroring Ingestion's own idempotency-by-reuse pattern for commits.
model AnalysisRun {
  id          String    @id @default(cuid())
  ingestionId String    @unique
  ingestion   Ingestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)

  status AnalysisStatus @default(PENDING)
  error  String?

  filesAnalyzed Int?
  symbolsFound  Int?
  importsFound  Int?
  findingsCount Int?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  symbols         CodeSymbol[]
  imports         CodeImport[]
  dependencyEdges DependencyEdge[]
  metrics         CodeMetric[]
  findings        Finding[]
  // Phase 5 — at most one, see EmbeddingRun's `@@unique([analysisRunId])`.
  embeddingRun    EmbeddingRun?
  chunks          CodeChunk[]
  // Phase 6 — at most one, see AIAnalysisRun's `@@unique([analysisRunId])`.
  aiAnalysisRun   AIAnalysisRun?

  @@index([ingestionId])
  @@map("analysis_run")
}

/// Mirrors packages/code-analysis's SymbolKind — duplicated, not imported,
/// for the same dependency-free reason as FileCategory above.
enum SymbolKind {
  FUNCTION
  METHOD
  CLASS
  INTERFACE
  TYPE
  ENUM
  VARIABLE
  CONSTANT
  MODULE
}

/// A function, class, method, ... discovered in one file during one
/// analysis run. Real AST-derived for TypeScript/JavaScript, heuristic
/// (regex/line-based) for Python/Java/C++/Go — see
/// packages/code-analysis/src/analysis and docs/code-intelligence.md.
model CodeSymbol {
  id            String         @id @default(cuid())
  analysisRunId String
  analysisRun   AnalysisRun    @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  fileId        String
  file          RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  name      String
  kind      SymbolKind
  startLine Int
  endLine   Int
  exported  Boolean
  signature String?

  /// Self-relation to an enclosing symbol in the same file (e.g. a method's
  /// class), resolved at persistence time from the parser's name-based
  /// `parentName` — nullable, since most symbols have no parent.
  parentId String?
  parent   CodeSymbol?  @relation("SymbolParent", fields: [parentId], references: [id], onDelete: SetNull)
  children CodeSymbol[] @relation("SymbolParent")

  /// McCabe cyclomatic complexity — only populated for AST-parsed
  /// (TypeScript/JavaScript) FUNCTION/METHOD symbols, `null` everywhere else.
  complexity     Int?
  parameterCount Int?

  createdAt DateTime @default(now())

  // Phase 5 — SetNull (not Cascade): a chunk that lost its enclosing symbol
  // (e.g. a re-analysis retry that wipes and recreates CodeSymbol rows,
  // same pattern as CodeImport.resolvedFileId) still carries its own
  // denormalized `symbolName` and line range, so it stays a perfectly good,
  // independently-citable chunk — it just loses the FK-resolved link.
  chunks CodeChunk[]

  @@index([analysisRunId])
  @@index([fileId])
  @@map("code_symbol")
}

/// Mirrors packages/code-analysis's ImportKind.
enum ImportKind {
  IMPORT
  REQUIRE
  DYNAMIC_IMPORT
  INCLUDE
}

/// One import/require/include statement found in one file, exactly as
/// written. Resolution into a same-repository target (or "external") is a
/// separate, derived concept — see DependencyEdge below.
model CodeImport {
  id            String         @id @default(cuid())
  analysisRunId String
  analysisRun   AnalysisRun    @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  fileId        String
  file          RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  source String
  kind   ImportKind
  line   Int

  /// The same-repository file this import resolves to, if any — only ever
  /// set for TypeScript/JavaScript relative imports (see
  /// packages/code-analysis/src/analysis/dependency-graph.ts); `null` for
  /// every external package and every heuristically-parsed language.
  resolvedFileId String?
  resolvedFile   RepositoryFile? @relation("ResolvedImport", fields: [resolvedFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([analysisRunId])
  @@index([fileId])
  @@map("code_import")
}

/// The resolved, file-to-file dependency graph for one analysis run — one
/// row per import edge (not deduplicated across multiple import statements
/// between the same two files; a deliberate Phase 4 simplification, see
/// docs/code-intelligence.md). `targetFileId` is `null` for an external
/// (or unresolved) dependency.
model DependencyEdge {
  id            String      @id @default(cuid())
  analysisRunId String
  analysisRun   AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  sourceFileId String
  sourceFile   RepositoryFile  @relation("DependencyEdgeSource", fields: [sourceFileId], references: [id], onDelete: Cascade)
  targetFileId String?
  targetFile   RepositoryFile? @relation("DependencyEdgeTarget", fields: [targetFileId], references: [id], onDelete: Cascade)

  external  Boolean
  kind      ImportKind
  specifier String

  createdAt DateTime @default(now())

  @@index([analysisRunId])
  @@index([sourceFileId])
  @@map("dependency_edge")
}

/// Deterministic per-file metrics for one analysis run — see
/// packages/code-analysis/src/analysis/metrics.ts for exactly how each
/// count is defined.
model CodeMetric {
  id            String         @id @default(cuid())
  analysisRunId String
  analysisRun   AnalysisRun    @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  fileId        String
  file          RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  lineCount        Int
  codeLineCount    Int
  commentLineCount Int
  blankLineCount   Int
  functionCount    Int
  classCount       Int
  importCount      Int
  exportCount      Int
  /// Sum of the file's function/method complexities — `null` for files
  /// that aren't AST-parsed (see CodeMetrics's doc comment in
  /// packages/code-analysis).
  complexity       Int?

  createdAt DateTime @default(now())

  @@unique([analysisRunId, fileId])
  @@index([analysisRunId])
  @@map("code_metric")
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// A deterministic static-analysis finding — never AI-generated (see
/// packages/code-analysis/src/analysis/rules). `fileId` is nullable so the
/// schema doesn't assume every possible rule is file-scoped, even though
/// every rule Phase 4 ships today is.
model Finding {
  id            String          @id @default(cuid())
  analysisRunId String
  analysisRun   AnalysisRun     @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  fileId        String?
  file          RepositoryFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)

  ruleId   String
  severity Severity
  message  String
  line     Int?
  column   Int?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([analysisRunId])
  @@index([fileId])
  @@map("finding")
}

// ---------------------------------------------------------------------------
// Phase 5 — Semantic Search + RAG Foundation
//
// Turns already-parsed source (RepositoryFile content, re-fetched the same
// way Phase 4's analysis does, plus Phase 4's CodeSymbol boundaries) into
// deterministically-chunked, embedded, pgvector-searchable CodeChunk rows.
// No AI agents, no chat, no LLM-generated summaries here — this is the
// retrieval layer Phase 6's agents will consume. See docs/semantic-search.md.
// ---------------------------------------------------------------------------

/// Explicit embedding state machine, named to match Ingestion/AnalysisRun's
/// convention — but deliberately fewer states (see EmbeddingRunStatus's
/// mirror in packages/shared/src/embedding.ts for why: no PARSING/INDEXING/
/// ANALYZING-style breakdown, one `EMBEDDING` state covers the whole
/// download → chunk → diff → embed → persist sequence).
enum EmbeddingRunStatus {
  PENDING
  QUEUED
  EMBEDDING
  COMPLETED
  FAILED
}

/// One attempt at building (or incrementally updating) the semantic index
/// for one analysis run's current content. One-to-one with its AnalysisRun
/// (`@@unique([analysisRunId])`) — mirrors AnalysisRun's own reuse-by-id
/// relationship with Ingestion: re-requesting embedding for the same
/// analysis run reuses (and resets) this same row rather than accumulating
/// attempts as separate rows, which is also what makes "prevent multiple
/// active embedding jobs for the same analysis" fall out for free (the
/// unique constraint plus an active-status check on the existing row — see
/// apps/api/src/routes/embeddings.ts).
model EmbeddingRun {
  id            String      @id @default(cuid())
  repositoryId  String
  repository    Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  analysisRunId String      @unique
  analysisRun   AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  status EmbeddingRunStatus @default(PENDING)
  error  String?

  /// The embedding model and its output vector width actually used for this
  /// run — recorded per-run (not just read from env at query time) so a
  /// historical run stays honestly labeled even if EMBEDDING_MODEL /
  /// EMBEDDING_DIMENSIONS change later. See docs/semantic-search.md.
  model      String
  dimensions Int

  /// Populated as soon as the diff against existing chunks is known —
  /// before any embedding API call is made — so the UI's progress bar has a
  /// real denominator from the start. See docs/semantic-search.md's
  /// incremental-embedding section.
  chunksDiscovered Int?
  chunksReused     Int?
  /// Incremented as each embedding batch completes (not set once at the
  /// end) — this is the field the "N / total chunks" progress bar polls.
  /// Never a fake/simulated increment; only ever written after a batch's
  /// vectors are actually persisted.
  chunksEmbedded   Int?
  chunksDeleted    Int?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chunks CodeChunk[]

  @@index([repositoryId])
  @@map("embedding_run")
}

/// A deterministically-chunked, embedded slice of one source file — the
/// unit semantic search retrieves and RAG context cites. Reused in place
/// (same row, `fileId`/`chunkIndex` pair) across re-embeds of the *same*
/// ingestion whose content hash hasn't changed, rather than deleted and
/// recreated — see docs/semantic-search.md's incremental-embedding section
/// for exactly what "incremental" does and does not cover in this phase.
///
/// `embedding` is added by this model's migration via raw SQL as
/// `vector(1536)` (Prisma's `Unsupported(...)` type below is a placeholder
/// that tells `prisma migrate` to preserve whatever raw SQL type the
/// migration file declares, and tells Prisma Client to exclude the column
/// from its generated read/write types — every embedding read/write in this
/// codebase goes through `$queryRaw`/`$executeRaw` with an explicit
/// `::vector` cast, never the generated client). 1536 is `text-embedding-3-small`'s
/// actual output width, matching `EMBEDDING_DIMENSIONS`'s default in
/// packages/shared/src/env.ts — not a guess.
model CodeChunk {
  id             String         @id @default(cuid())
  repositoryId   String
  repository     Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  fileId         String
  file           RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  analysisRunId  String
  analysisRun    AnalysisRun    @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  embeddingRunId String
  embeddingRun   EmbeddingRun   @relation(fields: [embeddingRunId], references: [id], onDelete: Cascade)

  /// Denormalized alongside the `fileId` FK — RepositoryFile.path, at the
  /// time this chunk was (re-)persisted. Search results and RAG citations
  /// read this directly rather than joining RepositoryFile on every query.
  filePath String

  chunkIndex  Int
  content     String
  /// SHA-256 hex digest over `${filePath}::${chunkIndex}::${content}` — see
  /// packages/code-analysis/src/chunking. The identity boundary for
  /// incremental embedding: unchanged hash for an existing
  /// (fileId, chunkIndex) pair means "reuse the existing vector, skip the
  /// embedding API call."
  contentHash String

  startLine Int?
  endLine   Int?

  symbolId   String?
  symbol     CodeSymbol? @relation(fields: [symbolId], references: [id], onDelete: SetNull)
  /// Denormalized from CodeSymbol.name at chunk time — survives the symbol
  /// row itself being deleted (SetNull above) on a re-analysis retry.
  symbolName String?

  language  String
  charCount Int

  /// vector(1536) — added via raw SQL in this model's migration; see the
  /// model-level doc comment above for why Prisma can't express this
  /// natively. `Unsupported(...)` here exists only so `prisma db pull` /
  /// schema introspection stays accurate — it is never read or written
  /// through Prisma Client.
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The identity a re-embed diffs against — see the model doc comment.
  @@unique([fileId, chunkIndex])
  @@index([repositoryId])
  @@index([analysisRunId])
  @@index([embeddingRunId])
  @@index([contentHash])
  @@map("code_chunk")
}

// ---------------------------------------------------------------------------
// Phase 6 — AI Code Analysis Agents
//
// Seven specialized agents interpret what Phases 4 (deterministic findings)
// and 5 (semantic retrieval/RAG) already computed — this phase adds no new
// static-analysis engine and no new vector store; it's the first phase that
// makes an LLM call whose *output* is itself persisted and shown to the
// user (Phase 5's only model call, the embedding API, never was). See
// docs/ai-analysis.md.
// ---------------------------------------------------------------------------

/// Run-level state machine, named to match AnalysisRun/EmbeddingRun's
/// convention. `COMPLETED_WITH_WARNINGS` (not just COMPLETED/FAILED) is
/// deliberate — a single agent failing (a transient OpenAI error exhausting
/// retries, a schema-validation failure exhausting its bounded retry)
/// should not discard the five-or-six agents that succeeded; see
/// docs/ai-analysis.md's "partial failure" section.
enum AIAnalysisStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
}

/// Exactly seven values — six primary agents plus the executive summary
/// agent that synthesizes them. Never extended speculatively; see
/// docs/ai-analysis.md for what each one analyzes and why exactly these
/// seven, not more.
enum AgentType {
  ARCHITECTURE
  CODE_QUALITY
  SECURITY
  PERFORMANCE
  DEPENDENCY_RISK
  DOCUMENTATION
  EXECUTIVE_SUMMARY
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum AIFindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

/// One attempt at running all seven AI agents over one analysis run's
/// already-persisted deterministic findings and semantic index. One-to-one
/// with its AnalysisRun (`@@unique([analysisRunId])`) — mirrors
/// EmbeddingRun's own reuse-by-id relationship with AnalysisRun: a re-run
/// reuses (and resets) this same row rather than accumulating attempts as
/// separate rows, which is also what makes "prevent multiple active AI
/// analysis jobs for the same analysis" fall out for free (the unique
/// constraint plus an active-status check on the existing row — see
/// apps/api/src/routes/ai-analysis.ts). AI analysis is *not* idempotently
/// reused on COMPLETED the way Ingestion reuses a completed commit — same
/// reasoning as AnalysisRun's own non-reuse of a COMPLETED run (the engine
/// itself, or the underlying deterministic/semantic data, can change
/// between two requests).
model AIAnalysisRun {
  id            String      @id @default(cuid())
  repositoryId  String
  repository    Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  analysisRunId String      @unique
  analysisRun   AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  status AIAnalysisStatus @default(PENDING)
  error  String?

  /// Recorded per-run (not just read from env at query time), same reasoning
  /// as EmbeddingRun.model/dimensions — a historical run stays honestly
  /// labeled even if OPENAI_MODEL changes later.
  provider String
  model    String

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agentRuns AgentRun[]
  AIFinding AIFinding[]

  @@index([repositoryId])
  @@map("ai_analysis_run")
}

/// One agent's execution within one AIAnalysisRun. `result` is the agent's
/// complete validated structured output (its Zod schema-shaped JSON) — kept
/// as the full record; `AIFinding` rows below are the same findings
/// normalized into individually queryable/filterable rows (severity,
/// agent), not a duplicate representation of different data.
model AgentRun {
  id              String        @id @default(cuid())
  aiAnalysisRunId String
  aiAnalysisRun   AIAnalysisRun @relation(fields: [aiAnalysisRunId], references: [id], onDelete: Cascade)

  agent  AgentType
  status AgentRunStatus @default(PENDING)

  /// Mirrors the agent's own structured `summary` field — denormalized here
  /// so an agent-cards list view never needs to unpack `result` just to
  /// show a one-line summary per card.
  summary String?
  /// The agent's full structured output, already validated against its Zod
  /// schema before being written — never partially-validated or raw model
  /// text.
  result  Json?
  error   String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  findings AIFinding[]

  /// One row per agent per run — the orchestrator creates all seven up
  /// front (PENDING) so progress ("2 of 7 agents complete") is always a
  /// real query, never inferred.
  @@unique([aiAnalysisRunId, agent])
  @@index([aiAnalysisRunId])
  @@map("agent_run")
}

/// One AI-generated finding, normalized out of its parent AgentRun.result
/// for querying/filtering (by severity, by run) without unpacking JSON.
/// Never AI-generated *without* citations — `citations` always has at
/// least one entry, enforced by the Zod schema every finding is validated
/// against before this row is ever written (packages/ai/src/agents/schemas.ts).
model AIFinding {
  id              String        @id @default(cuid())
  agentRunId      String
  agentRun        AgentRun      @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  /// Denormalized — every finding list/filter query in the API is scoped by
  /// the parent AIAnalysisRun, not by agent, so this avoids a join through
  /// AgentRun on every read (same reasoning as CodeChunk.repositoryId).
  aiAnalysisRunId String
  aiAnalysisRun   AIAnalysisRun @relation(fields: [aiAnalysisRunId], references: [id], onDelete: Cascade)

  /// Agent-defined free-text category (e.g. "coupling", "hardcoded-secret")
  /// — not an enum; the seven agents' subject matter is too varied for a
  /// fixed category list to stay meaningful, unlike `severity` below.
  category       String
  title          String
  summary        String
  severity       AIFindingSeverity
  /// 0..1 — the model's own self-reported confidence, never fabricated by
  /// this codebase; see docs/ai-analysis.md's "confidence" section for how
  /// agents are instructed to calibrate it.
  confidence     Float
  /// What the retrieved evidence actually shows — distinct from
  /// `recommendation` (what to do about it), enforcing the guardrail
  /// separation between evidence and inference. See
  /// docs/ai-analysis.md's "citations" section.
  evidence       String
  recommendation String
  /// JSON array of `{ filePath, startLine, endLine, symbolName }` —
  /// grounded in retrieval evidence actually handed to the model, never
  /// invented by it (enforced by prompt + schema, not just asked nicely —
  /// see docs/ai-analysis.md's "citations" section).
  citations      Json

  createdAt DateTime @default(now())

  @@index([agentRunId])
  @@index([aiAnalysisRunId])
  @@index([severity])
  @@map("ai_finding")
}
