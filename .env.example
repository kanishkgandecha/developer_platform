# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored — never commit real secrets.
#
# Docker Compose injects these into each service directly (see
# docker-compose.yml); this file is what you use for host-side commands like
# `pnpm prisma migrate dev` or `pnpm dev` outside of Docker.

# ---------------------------------------------------------------------------
# Required to boot — the app fails fast with a clear error if any of these
# are missing or malformed. See packages/shared/src/env.ts.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Postgres connection string. Matches the credentials in docker-compose.yml.
# Use `localhost` when running commands on the host machine; use the service
# name `postgres` when running *inside* another Docker Compose service.
DATABASE_URL=postgresql://developer_platform:developer_platform@localhost:5432/developer_platform

# Redis connection string. Same host-vs-service-name distinction as above.
REDIS_URL=redis://localhost:6379

# Used to sign/encrypt session-related material.
# Generate a real one with: openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-change-me-before-deploying-0123456789

# ---------------------------------------------------------------------------
# GitHub OAuth (Phase 2) — see docs/github-integration.md for the full setup.
# ---------------------------------------------------------------------------

# From your GitHub OAuth App (github.com/settings/developers). The
# placeholders below are enough to boot the stack and exercise everything
# except the real GitHub redirect — the app checks whether these look like
# real credentials before attempting an OAuth exchange, so it fails with a
# clear message instead of a broken redirect.
GITHUB_CLIENT_ID=dev-placeholder-client-id
GITHUB_CLIENT_SECRET=dev-placeholder-client-secret

# AES-256-GCM key used to encrypt GitHub access tokens at rest — 32 random
# bytes, base64-encoded. The value below is a fixed *local-dev-only* key so
# `docker compose up` works out of the box; generate and use a unique one
# per real environment with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=Ze4okDGlt+nM/DCpaksBtTuKINKkpsncYJYRnjL1FuY=

# Where the browser lives. Used to build the post-login redirect and as the
# API's CORS-allowed origin — never derived from request headers.
WEB_URL=http://localhost:3000

# The API's own externally-reachable base URL. Used to build the GitHub
# OAuth callback URL — must exactly match the "Authorization callback URL"
# configured on the GitHub OAuth App.
API_PUBLIC_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Repository ingestion (Phase 3) — read by apps/worker. All have sensible
# defaults (shown below); only set these to override them. See
# docs/repository-ingestion.md.
# ---------------------------------------------------------------------------

# Where each ingestion's isolated temporary workspace is created, relative
# to the worker process's cwd (resolves to /app/workspaces in Docker,
# apps/worker/workspaces for local `pnpm dev`). Never persisted — cleaned up
# when a job finishes, success or failure.
INGESTION_WORKSPACE_DIR=./workspaces

# Hard caps enforced *during* extraction (not after) — zip-bomb and
# oversized-repository protection. A limit being hit fails that ingestion
# cleanly (status FAILED, reason recorded); it never crashes the worker.
MAX_REPOSITORY_SIZE_MB=500
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REPOSITORY=5000

# ---------------------------------------------------------------------------
# Reserved for later phases — optional, nothing reads these yet.
# ---------------------------------------------------------------------------

# Phase 5+: OpenAI API key for the agent framework. Server-side only, never
# exposed to the Next.js browser bundle.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------

# Server-side address the Next.js server itself uses to reach the API (e.g.
# for the /status page's health check, and for forwarding the session cookie
# on authenticated SSR requests). Inside Docker Compose this is the service
# name (`http://api:4000`); set in docker-compose.yml directly.
API_URL=http://localhost:4000

# Browser-visible address for the API. NEXT_PUBLIC_ vars are the only ones
# ever bundled into client-side JS — never put a secret behind this prefix.
# Used for the "Continue with GitHub" link, which is a real browser
# navigation straight to the API (not an XHR/fetch), so it must be the
# host-reachable address, not the Docker-internal one.
NEXT_PUBLIC_API_URL=http://localhost:4000
